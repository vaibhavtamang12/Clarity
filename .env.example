# =====================================================================
# RAG Knowledge Intelligence Platform — environment template
# Copy to `.env` and adjust. NEVER commit real secrets.
# Nested keys use double underscore: <GROUP>__<FIELD>
# =====================================================================

# ---- Application ----
APP__NAME=rag-knowledge-platform
APP__ENVIRONMENT=dev            # dev | test | staging | prod
APP__DEBUG=true
APP__LOG_LEVEL=INFO
APP__LOG_JSON=false             # true in prod for JSON logs
APP__CORS_ORIGINS=["http://localhost:3000"]

# ---- PostgreSQL ----
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=rag_user
DATABASE__PASSWORD=rag_password
DATABASE__NAME=rag_platform
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__ECHO=false

# ---- Redis ----
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
# REDIS__PASSWORD=

# ---- Qdrant ----
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__GRPC_PORT=6334
QDRANT__PREFER_GRPC=false
QDRANT__COLLECTION_PREFIX=rag
# QDRANT__API_KEY=

# ---- MLflow ----
MLFLOW__TRACKING_URI=http://localhost:5001
MLFLOW__EXPERIMENT_NAME=rag-platform
MLFLOW__ENABLED=true

# ---- Embeddings (keys into configs/embeddings.yaml) ----
EMBEDDING__DEFAULT_MODEL=bge_m3
EMBEDDING__BATCH_SIZE=32
EMBEDDING__DEVICE=cpu

# ---- Reranker ----
RERANKER__MODEL=BAAI/bge-reranker-v2-m3
RERANKER__ENABLED=true
RERANKER__CANDIDATES=50
RERANKER__TOP_N=10

# ---- LLM (ADR-005) ----
LLM__PROVIDER=openai_compatible   # openai_compatible | anthropic | ollama
LLM__MODEL=gpt-4o-mini
LLM__BASE_URL=                    # e.g. http://localhost:11434/v1 for Ollama
LLM__API_KEY=
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024
LLM__TIMEOUT_SECONDS=30
LLM__MAX_RETRIES=2

# ---- Retrieval ----
RETRIEVAL__DENSE_TOP_K=50
RETRIEVAL__SPARSE_TOP_K=50
RETRIEVAL__FINAL_TOP_K=10
RETRIEVAL__FUSION_STRATEGY=rrf    # rrf | weighted
RETRIEVAL__RRF_K=60
RETRIEVAL__DENSE_WEIGHT=0.7
RETRIEVAL__SPARSE_WEIGHT=0.3
RETRIEVAL__DEGRADE_POLICY=degrade # strict | degrade (ARCHITECTURE.md section 9)

# ---- Ingestion ----
INGESTION__MAX_FILE_SIZE_MB=50
INGESTION__MAX_ATTEMPTS=3
INGESTION__RETRY_BASE_DELAY_SECONDS=2
INGESTION__PARSER_TIMEOUT_SECONDS=120

# ---- Cache ----
CACHE__ENABLED=true
CACHE__RAG_RESPONSE_TTL_SECONDS=3600
CACHE__EMBEDDING_TTL_SECONDS=86400

# ---- Security ----
SECURITY__RATE_LIMIT_PER_MINUTE=60

# ---- Embeddings (keys into configs/embeddings.yaml) ----
EMBEDDING__DEFAULT_MODEL=bge_m3
EMBEDDING__BATCH_SIZE=32
EMBEDDING__DEVICE=cpu
EMBEDDING__MAX_RETRIES=2                # Phase 6: transient inference retries
EMBEDDING__RETRY_BASE_DELAY_SECONDS=0.5